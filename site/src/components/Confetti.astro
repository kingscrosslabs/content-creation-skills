---
/**
 * Decorative cut-paper shapes. Rules (see DESIGN.md, "Confetti"):
 * aria-hidden, never interactive, never on running text. Each placement has a
 * `wide` position in the page gutter (shown at 1440px and up, where a gutter
 * exists) and may have a `narrow` position inside the section's top padding
 * band (shown below 1440px). Motion stops under prefers-reduced-motion.
 */
import type { Piece, Shape, Motion } from "../data/confetti";
interface Props { pieces: Piece[] }
const { pieces } = Astro.props;

const paths: Record<Shape, { vb: string; d: string; kind?: "circle" | "dots" }> = {
  sparkle: { vb: "0 0 40 40", d: "M20 2 L23 17 L38 20 L23 23 L20 38 L17 23 L2 20 L17 17 Z" },
  ring: { vb: "0 0 40 40", d: "", kind: "circle" },
  squiggle: { vb: "0 0 64 20", d: "M3 10 Q 10.5 0 18 10 T 33 10 T 48 10 T 61 10" },
  zigzag: { vb: "0 0 64 20", d: "M3 16 L13 4 L23 16 L33 4 L43 16 L53 4 L61 14" },
  cross: { vb: "0 0 40 40", d: "M10 10 L30 30 M30 10 L10 30" },
  triangle: { vb: "0 0 40 40", d: "M20 5 L36 34 L4 34 Z" },
  dots: { vb: "0 0 40 40", d: "", kind: "dots" },
  arc: { vb: "0 0 40 24", d: "M4 21 A 16 16 0 0 1 36 21" },
  disc: { vb: "0 0 40 40", d: "", kind: "circle" },
  capsule: { vb: "0 0 48 20", d: "M12 3 H36 A7 7 0 0 1 36 17 H12 A7 7 0 0 1 12 3 Z" },
};
const durations: Record<Motion, number> = { spin: 22, bob: 7, sway: 9, drift: 11, pulse: 6 };
---
{pieces.map((p, i) => {
  const shape = paths[p.shape];
  const filled = p.fill || p.shape === "disc";
  const style = [
    `--w:${p.size}px`,
    `--top:${p.wide.top}`,
    `--x:${p.wide.x}`,
    p.narrow && `--ntop:${p.narrow.top}`,
    p.narrow && `--nx:${p.narrow.x}`,
    `--dur:${durations[p.motion] + (i % 3) * 1.7}s`,
    `--delay:${-(i * 1.3)}s`,
  ].filter(Boolean).join(";");
  return (
    <svg
      class:list={["confetti", p.side, p.motion, p.muted && "muted", filled && "filled", p.narrow && "has-narrow"]}
      viewBox={shape.vb}
      style={style}
      aria-hidden="true"
      focusable="false"
    >
      {shape.kind === "circle" && <circle cx="20" cy="20" r={filled ? 14 : 15} />}
      {shape.kind === "dots" && [8, 20, 32].flatMap((x) => [8, 20, 32].map((y) => <circle cx={x} cy={y} r="2.6" class="dot" />))}
      {!shape.kind && <path d={shape.d} />}
    </svg>
  );
})}

<style>
  .confetti {
    position: absolute;
    width: var(--w);
    height: auto;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    display: none;
    animation: var(--motion) var(--dur) ease-in-out var(--delay) infinite;
  }
  .confetti.muted { stroke: var(--line-strong); }
  .confetti.filled, .confetti .dot { fill: var(--accent); stroke: none; }
  .confetti.muted.filled, .confetti.muted .dot { fill: var(--line-strong); }

  /* Narrow: inside the section's top padding band, clear of text. */
  @media (max-width: 1439px) {
    .confetti.has-narrow { display: block; top: var(--ntop); width: min(var(--w), 28px); }
    .confetti.has-narrow.left { left: var(--nx); }
    .confetti.has-narrow.right { right: var(--nx); }
  }
  /* Wide: in the gutter outside the content column. */
  @media (min-width: 1440px) {
    .confetti { display: block; top: var(--top); }
    .confetti.left { left: max(8px, calc((100% - var(--max)) / 2 - var(--w) - var(--x))); }
    .confetti.right { right: max(8px, calc((100% - var(--max)) / 2 - var(--w) - var(--x))); }
  }

  .spin { --motion: c-spin; animation-timing-function: linear; }
  .bob { --motion: c-bob; }
  .sway { --motion: c-sway; }
  .drift { --motion: c-drift; }
  .pulse { --motion: c-pulse; }
  @keyframes c-spin { to { transform: rotate(360deg); } }
  @keyframes c-bob { 50% { transform: translateY(-12px); } }
  @keyframes c-sway { 0%, 100% { transform: rotate(-12deg); } 50% { transform: rotate(12deg); } }
  @keyframes c-drift { 0%, 100% { transform: translate(0, 0); } 33% { transform: translate(8px, -6px); } 66% { transform: translate(-6px, 6px); } }
  @keyframes c-pulse { 50% { transform: scale(1.18); } }
</style>
