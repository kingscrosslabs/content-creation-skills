---
import Confetti from "./Confetti.astro";
import { confetti } from "../data/confetti";
import { site } from "../data/site";
const logos = import.meta.glob<string>("../assets/agents/*.svg", { query: "?raw", import: "default", eager: true });
const logo = (icon: string) => logos[`../assets/agents/${icon}.svg`] ?? "";
---
<section class="section" id="agents">
  <Confetti pieces={confetti.agents} />
  <div class="wrap">
    <div class="section-head">
      <h2>{site.agents.heading}</h2>
      <p>{site.agents.sub}</p>
    </div>
    <ul class="agents">
      {site.agents.list.map((a) => <li><span class="logo" set:html={logo(a.icon)} />{a.name}</li>)}
      <li class="any">Any agent that reads <code>SKILL.md</code></li>
    </ul>
    <p class="foot" set:html={site.agents.footnote} />
  </div>
</section>

<style>
  .agents {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(150px, 100%), 1fr));
  }
  .agents li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 0 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(16px, 2vw, 18px);
    letter-spacing: -0.02em;
  }
  .logo { display: inline-flex; width: 26px; height: 26px; flex-shrink: 0; color: var(--text); }
  .logo :global(svg) { width: 100%; height: 100%; }
  .agents li.any { grid-column: span 2; }
  @media (max-width: 340px) { .agents li.any { grid-column: auto; } }
  .agents li.any { font-family: var(--font-body); font-size: 15px; color: var(--muted); letter-spacing: 0; border-style: dashed; }
  .foot { color: var(--muted); font-size: 15px; margin-top: 24px; max-width: 680px; }
</style>
