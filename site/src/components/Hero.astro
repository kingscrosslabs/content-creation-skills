---
import { site } from "../data/site";
import StarButton from "./StarButton.astro";
import Terminal from "./Terminal.astro";
const skillCount = site.groups.reduce((n, g) => n + g.skills.length, 0);
---
<section class="hero">
  <svg class="shape s1" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 2 L23 17 L38 20 L23 23 L20 38 L17 23 L2 20 L17 17 Z" /></svg>
  <svg class="shape s2" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="16" /></svg>
  <svg class="shape s3" viewBox="0 0 60 20" aria-hidden="true"><path d="M2 10 Q 9.5 0 17 10 T 32 10 T 47 10 T 58 10" /></svg>

  <div class="wrap">
    <p class="eyebrow">{site.hero.eyebrow}</p>
    <h1>{site.hero.headline} <span class="accent">{site.hero.highlight}</span></h1>
    <p class="sub">{site.hero.sub}</p>
    <Terminal command={site.install} />
    <div class="ctas">
      <StarButton />
      <a class="btn btn-secondary" href="#skills">See the {skillCount} skills <span aria-hidden="true">↓</span></a>
    </div>
    {site.hero.note && <p class="note">{site.hero.note}</p>}
  </div>
</section>

<style>
  .hero { position: relative; padding: clamp(64px, 11vw, 128px) 0 var(--section); overflow: hidden; }
  h1 { margin: 20px 0 24px; max-width: 13ch; }
  .sub { font-size: clamp(18px, 2vw, 21px); line-height: 1.45; color: var(--muted); max-width: 620px; margin-bottom: 36px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .note { margin-top: 20px; font-size: 14px; color: var(--muted); }

  .shape { position: absolute; fill: none; stroke: var(--accent); stroke-width: 2; display: none; pointer-events: none; }
  .s1 { width: 56px; right: 8%; top: 18%; animation: spin 18s linear infinite; }
  .s2 { width: 44px; right: 20%; top: 52%; opacity: 0.7; animation: bob 7s ease-in-out infinite; }
  .s3 { width: 96px; right: 6%; top: 72%; opacity: 0.85; animation: bob 9s ease-in-out infinite reverse; }
  @media (min-width: 1100px) { .shape { display: block; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes bob { 50% { transform: translateY(-10px); } }
</style>
