---
import Confetti from "./Confetti.astro";
import { confetti } from "../data/confetti";
import { site } from "../data/site";
---
<section class="section" id="faq">
  <Confetti pieces={confetti.faq} />
  <div class="wrap grid">
    <h2>FAQ</h2>
    <div class="list">
      {site.faqs.map((f) => (
        <details>
          <summary><span>{f.q}</span><span class="icon" aria-hidden="true">+</span></summary>
          <p set:html={f.a} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 32px; }
  @media (min-width: 960px) { .grid { grid-template-columns: 1fr 2fr; gap: 80px; } }
  .list { display: grid; gap: 8px; }
  details { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  details[open] { border-color: var(--line-strong); }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 17px;
  }
  summary::-webkit-details-marker { display: none; }
  .icon { font-family: var(--font-mono); font-size: 20px; color: var(--accent); transition: transform 0.2s; flex-shrink: 0; }
  details[open] .icon { transform: rotate(45deg); }
  details p { padding: 0 22px 22px; color: var(--muted); font-size: 16px; max-width: 640px; }
</style>
