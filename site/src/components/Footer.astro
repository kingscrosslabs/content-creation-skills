---
import Confetti from "./Confetti.astro";
import { confetti } from "../data/confetti";
import { site } from "../data/site";
import StarButton from "./StarButton.astro";
const year = new Date().getFullYear();
const kcl = [
  { name: "Adeli", url: "https://tryadeli.com", blurb: "One API for social publishing, analytics and ads." },
  { name: "LedaChat", url: "https://ledachat.com", blurb: "Instagram comment-to-DM automations, set up from Claude." },
  { name: "Free AI Guides", url: "https://mikareyes.com/ai", blurb: "Step-by-step AI workflows by Mika Reyes." },
  { name: "King's Cross Labs", url: "https://kingscrosslabs.com", blurb: "The studio behind these skills." },
];
---
<footer>
  <Confetti pieces={confetti.footer} />
  <div class="wrap">
    <div class="cta">
      <h2>{site.closing}</h2>
      <StarButton />
    </div>

    <div class="cols">
      <div class="brand">
        <a class="mark" href="/"><span class="glyph" aria-hidden="true">✦</span>{site.wordmark}</a>
        <p>{site.description}</p>
      </div>
      <div>
        <h3>Project</h3>
        <ul>
          <li><a href={site.repo} rel="noopener">GitHub</a></li>
          <li><a href={site.skillsPath} rel="noopener">All skills</a></li>
          <li><a href={`${site.repo}/blob/main/LICENSE`} rel="noopener">MIT licence</a></li>
        </ul>
      </div>
      <div>
        <h3>More from KCL</h3>
        <ul>
          <li><a href={site.sister.url}>{site.sister.name}</a><span>{site.sister.blurb}</span></li>
          {kcl.map((l) => <li><a href={l.url} rel="noopener">{l.name}</a><span>{l.blurb}</span></li>)}
        </ul>
      </div>
    </div>

    <p class="legal">
      Built by <a href="https://mikareyes.com" rel="noopener">Mika Reyes</a> at
      <a href="https://kingscrosslabs.com" rel="noopener">King's Cross Labs</a>. © {year} King's Cross Labs. Open source under the MIT licence.
    </p>
  </div>
</footer>

<style>
  footer { position: relative; overflow: hidden; border-top: 1px solid var(--line); padding: var(--section) 0 40px; }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: var(--section);
    border-bottom: 1px solid var(--line);
  }
  .cta h2 { max-width: 22ch; }
  .cols { display: grid; gap: 40px; padding: 56px 0; }
  @media (min-width: 760px) { .cols { grid-template-columns: 2fr 1fr 1fr; } }
  .mark { font-family: var(--font-mono); font-size: 15px; text-decoration: none; display: inline-flex; gap: 8px; }
  .glyph { color: var(--accent); }
  .brand p { color: var(--muted); font-size: 15px; margin-top: 14px; max-width: 420px; }
  h3 { font-family: var(--font-body); font-size: 13px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  li { display: grid; gap: 2px; }
  li a { text-decoration: none; font-size: 15px; }
  li a:hover { color: var(--accent); }
  li span { color: var(--muted); font-size: 13px; }
  .legal { color: var(--muted); font-size: 13px; border-top: 1px solid var(--line); padding-top: 24px; }
  .legal a { text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .legal a:hover { color: var(--text); }
</style>
